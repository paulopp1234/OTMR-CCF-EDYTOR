<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <InformationalVersion>0.3.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>OTMR CCF Editor / Creator</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CcfEditor.Core\CcfEditor.Core.csproj" />
    <ProjectReference Include="..\CcfEditor.Otmr\CcfEditor.Otmr.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <Compile Update="OtmrLiveControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="OtmrLiveControl.Designer.cs">
      <DependentUpon>OtmrLiveControl.cs</DependentUpon>
    </Compile>
    <Compile Update="OtmrServerSyncControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="OtmrServerSyncControl.Designer.cs">
      <DependentUpon>OtmrServerSyncControl.cs</DependentUpon>
    </Compile>
    <Compile Update="OtmrRcmLiveControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="OtmrRcmLiveControl.Designer.cs">
      <DependentUpon>OtmrRcmLiveControl.cs</DependentUpon>
    </Compile>
    <Compile Update="OtmrBenchControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="OtmrBenchControl.Designer.cs">
      <DependentUpon>OtmrBenchControl.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!-- Empty designer artifacts for partial MainForm classes must not collide
         with the real MainForm.resx manifest resource. -->
    <EmbeddedResource Remove="MainForm.BenchIntegration.resx;MainForm.Database.resx" />
    <EmbeddedResource Update="MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="OtmrLiveControl.resx">
      <DependentUpon>OtmrLiveControl.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="OtmrBenchControl.resx">
      <DependentUpon>OtmrBenchControl.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Profiles\Class171\Class171_Bench_PinMap.tsv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
