{
  "OtmrServer": {
    "DatabasePath": "/var/lib/otmr/OTMR_RCM.db",
    "BearerToken": "",
    "ListenUrl": "http://127.0.0.1:5080",
    "MaximumUploadBodyBytes": 134217728,
    "MaximumQueryResultCount": 1000,
    "MaximumSessionResultCount": 100,
    "MaximumRecordRangeDays": 31,
    "MaximumRealtimeSignalUpdates": 1000,
    "LiveStaleAfterSeconds": 30,
    "WindowsAppOfflineAfterSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
