[Unit]
Description=OTMR recording synchronization server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=otmr
Group=otmr
WorkingDirectory=/opt/otmr/server
ExecStart=/usr/bin/dotnet /opt/otmr/server/CcfEditor.Otmr.Server.dll
Restart=on-failure
RestartSec=5
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=OtmrServer__ListenUrl=http://127.0.0.1:5080
Environment=OtmrServer__DatabasePath=/var/lib/otmr/OTMR_RCM.db
EnvironmentFile=/etc/otmr/otmr-server.env
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/otmr

[Install]
WantedBy=multi-user.target
